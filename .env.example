VEXCEL_API_KEY=
MATTERPORT_API_TOKEN=
MATTERPORT_API_KEY=
GEMINI_API_KEY=

# Server-only path to an existing local database (absolute or relative to repo root).
DUCKDB_PATH=/absolute/path/to/commercial_clean.duckdb

# Optional chat model override; does not change the spatial vision model.
GEMINI_CHAT_MODEL=gemini-3.8-flash

# Used only when Gemini has a transient, quota or timeout failure.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: required only for a key that is not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=

# Optional image-analysis model overrides and private spatial cache location.
GEMINI_VISION_MODEL=gemini-3.8-flash
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5
# SPATIAL_CACHE_DIR=cache/spatial-tools

# Matterport Showcase SDK key (browser-side, safe to expose; add localhost + demo domain to its allow list).
NEXT_PUBLIC_MATTERPORT_SDK_KEY=
