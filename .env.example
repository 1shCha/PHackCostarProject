# Copy to .env and fill in. Never commit .env.

# Amazon Bedrock (orchestrator). Copy the exact model ID from the Bedrock console for your region.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5

# Matterport Model API (Role 2) - from /costar-keys in Discord
MATTERPORT_API_TOKEN_ID=
MATTERPORT_API_TOKEN_SECRET=

# Vexcel (Role 2) - from /costar-keys in Discord
VEXCEL_API_KEY=

# Where the unzipped CoStar kit lives (Role 1)
COSTAR_KIT_DIR=data/kit

# Frontend -> backend
NEXT_PUBLIC_API_URL=http://localhost:8000
