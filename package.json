    "check:costar-tools": "node --conditions=react-server --import tsx --env-file=.env.local scripts/check-costar-tools.ts",
    "test:tenant-agent": "node --conditions=react-server --import tsx --test src/lib/ai/*.test.ts",
    "check:tenant-agent": "node --conditions=react-server --import tsx --env-file=.env.local scripts/check-tenant-agent.ts",
    "check:tenant-agent:offline": "node --conditions=react-server --import tsx --env-file=.env.local scripts/check-tenant-agent.ts --offline",
